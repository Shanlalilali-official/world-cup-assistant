# Frontend environment
#
# Local development can leave this blank because Vite proxies /api to
# http://localhost:3001 in client/vite.config.js.
#
# Production GitHub Pages must set this to the deployed backend origin.
VITE_API_URL=https://your-vercel-api.vercel.app

# Optional. Only set this if you deploy a persistent Socket.IO server.
# The Vercel serverless backend is better used with polling fallback.
VITE_SOCKET_URL=

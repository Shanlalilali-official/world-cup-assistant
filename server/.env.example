# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# For multiple deployed frontends, use a comma-separated list.
# CLIENT_URLS=http://localhost:5173,https://your-name.github.io

# === Core Data APIs ===

# SportScore API (free, no key required)
# SPORTSCORE_API_BASE=https://sportscore.com

# Football-Data.org (free tier, get key at https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=your_key_here

# Zafronix World Cup API (free tier, get key at https://zafronix.com)
# WC_API_KEY=your_key_here

# Bzzoiro Sports Data BSD (free, no key, xG + ML predictions)
# BSD_API_URL=https://sports.bzzoiro.com/api

# Highlightly API (100 req/day free, video highlights + xG stats)
# HIGHLIGHTLY_API_URL=https://api.highlightly.net

# === Enrichment APIs ===

# YouTube Data API v3 (free 10,000 units/day — for match highlights)
# Get key at: https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=your_key_here

# OpenWeatherMap (free 1,000 calls/day — for host city weather)
# Get key at: https://openweathermap.org/api
# OPENWEATHER_API_KEY=your_key_here

# === Social Media APIs ===

# X (Twitter) API — for social features
# Get keys at https://developer.twitter.com/
# TWITTER_ENABLED=false
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# Instagram Graph API — for social features
# INSTAGRAM_ENABLED=false
# INSTAGRAM_ACCESS_TOKEN=

# === Auto-posting ===

# AUTO_POST_ENABLED=false
# POST_FINAL_WHISTLE=true
# POST_DAILY_SUMMARY=false
# DAILY_SUMMARY_HOUR=8

# === AI News Summary (bring your own key) ===

# Works with OpenAI, Claude, or any OpenAI-compatible API
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sk-your-key-here
# AI_MODEL=gpt-4o-mini
# AI_SUMMARY_LANG=zh    # zh for Chinese summary, en for English
